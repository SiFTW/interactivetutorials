# Copy this file to server/.env and customize before running `docker compose up -d`.

# Public HTTPS hostname exposed via Cloudflare Tunnel pointing to the spawner
PUBLIC_BASE_URL=https://kernels.mitchell.science

# Local loopback port on 139.184.169.98 (only used if routing via host cloudflared)
SPAWNER_PORT=8787

# Pre-built Julia kernel image name
KERNEL_IMAGE=mitchell-lab/julia-tutorial-kernel:latest

# Comma-separated browser origins permitted to execute live cells
ALLOWED_ORIGINS=https://mitchell.science,https://www.mitchell.science,http://localhost:3000,http://127.0.0.1:3000

# Optional regex to allow Netlify deploy preview URLs (uncomment if desired)
# ALLOWED_ORIGIN_REGEX=^https://[a-z0-9-]+--[a-z0-9-]+\.netlify\.app$

# GitHub repositories allowed by the Binder SSE endpoint
ALLOWED_REPOS=SiFTW/interactivetutorials

# Resource caps to guarantee the research JupyterHub is never starved
MAX_CONCURRENT_SESSIONS=20
MAX_SESSIONS_PER_IP=3
CONTAINER_MEM_LIMIT=2g
CONTAINER_CPUS=2.0
CONTAINER_PIDS_LIMIT=256

# Automatic cleanup (seconds): 20 min idle, 2 hour max lifetime
IDLE_TIMEOUT_SECONDS=1200
MAX_SESSION_AGE_SECONDS=7200

# Dedicated private subnet for ephemeral user containers (no internet egress)
USER_SUBNET=172.30.240.0/24

# Only required if using the optional bundled cloudflared container:
#   docker compose --profile tunnel up -d
# Create a new tunnel in Cloudflare Zero Trust -> Networks -> Tunnels and
# route `kernels.mitchell.science` -> `http://spawner:8787`
CLOUDFLARE_TUNNEL_TOKEN=
